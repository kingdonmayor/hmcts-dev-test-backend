# Copy to .env before running docker compose:  cp .env.example .env
# .env is git-ignored — real credentials must never be committed.

# Application
SERVER_PORT=4000

# PostgreSQL — consumed by BOTH the postgres container (to initialise the
# database) and the app container (to connect to it).
DB_NAME=devtest
DB_USER_NAME=devtest
DB_PASSWORD=change-me-locally
DB_PORT=5432

# Extra JDBC URL options, ?sslmode=require in Azure. Empty locally.
DB_OPTIONS=
