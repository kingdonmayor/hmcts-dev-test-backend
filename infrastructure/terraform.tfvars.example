# Copy to prod.tfvars (git-ignored) and pass with -var-file.
# No secret ever belongs in this file: the database password is generated by
# Terraform and written directly to Key Vault.

environment = "prod"
location    = "uksouth"

product   = "hmcts-devtest"
component = "backend"

# Immutable tag published by the pipeline. Never "latest" in a real deployment.
container_registry_login_server = "hmctspublic.azurecr.io"
container_image_name            = "hmcts/test-backend"
container_image_tag             = "sha-a1b2c3d"

# Resource ID of the registry, so the app identity can be granted AcrPull.
# container_registry_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/acr-rg/providers/Microsoft.ContainerRegistry/registries/hmctspublic"

postgres_sku_name                     = "GP_Standard_D2ds_v5"
postgres_storage_mb                   = 32768
postgres_backup_retention_days        = 14
postgres_geo_redundant_backup_enabled = true
postgres_high_availability_enabled    = true

min_replicas = 2
max_replicas = 10

common_tags = {
  application = "case-management"
  criticality = "high"
}
